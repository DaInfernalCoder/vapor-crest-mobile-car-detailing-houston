{
  "config": {
    "cleanUrls": true,
    "trailingSlash": false,
    "headers": [
      {
        "source": "/(.*)",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=()"
          }
        ]
      },
      {
        "source": "/assets/(.*)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ]
  },
  "domains": [
    {
      "name": "www.fulshearcardetailing.shop",
      "apexName": "fulshearcardetailing.shop",
      "redirect": "fulshearcardetailing.shop",
      "redirectStatusCode": 308,
      "verified": true
    },
    {
      "name": "fulshearcardetailing.shop",
      "apexName": "fulshearcardetailing.shop",
      "redirect": null,
      "redirectStatusCode": null,
      "verified": true
    },
    {
      "name": "www.vaporcrest.shop",
      "apexName": "vaporcrest.shop",
      "redirect": "fulshearcardetailing.shop",
      "redirectStatusCode": 308,
      "verified": true
    },
    {
      "name": "vaporcrest.shop",
      "apexName": "vaporcrest.shop",
      "redirect": "fulshearcardetailing.shop",
      "redirectStatusCode": 308,
      "verified": true
    }
  ],
  "files": [
    "/about/index.html",
    "/contact/index.html",
    "/index.html",
    "/llms.txt",
    "/robots.txt",
    "/script.js",
    "/seo-pages.css",
    "/services/exterior-car-detailing/index.html",
    "/services/headlight-restoration/index.html",
    "/services/index.html",
    "/services/interior-car-detailing/index.html",
    "/services/mobile-car-wash/index.html",
    "/sitemap.xml",
    "/styles.css"
  ]
}
